# Copie como .env e ajuste. Nunca versione o .env: ele guarda a chave da
# aplicação e a senha do banco.
#
#   cp .env.example .env
#   php artisan key:generate

APP_NAME="Associação Tech PG"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Para desenvolver, o SQLite basta e não exige instalar nada:
#   touch database/database.sqlite
#
# DB_CONNECTION=sqlite
#
# Para reproduzir a produção, use MariaDB/MySQL:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=atpg
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Em produção (HTTPS) isto vai para true; em desenvolvimento precisa ficar
# false, senão o cookie de sessão não trafega e não dá para entrar no painel.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Arquivo, e não database: o driver de banco corrompe payloads binários na
# coluna utf8mb4. Ver a seção "Notas de operação" no README.
CACHE_STORE=file

# ---------------------------------------------------------------------------
# E-mail
# ---------------------------------------------------------------------------
# "log" grava a mensagem em storage/logs em vez de enviar — ideal para
# desenvolver sem configurar SMTP.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="contato@atpg.net.br"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Administrador criado pelo seeder
# ---------------------------------------------------------------------------
# Se ADMIN_PASSWORD ficar vazio, o seeder gera uma senha aleatória e a mostra
# uma única vez no console. Não coloque senha real aqui em nenhum ambiente
# compartilhado.
ADMIN_EMAIL=admin@techpg.local
ADMIN_NAME="Administrador Tech PG"
ADMIN_PASSWORD=

# Só em produção: quando o servidor web serve o site de uma pasta fora da
# aplicação (public_html do DirectAdmin, por exemplo). Vazio usa ./public.
# Sem isto, o ?v= dos CSS congela e o navegador nunca busca a versão nova.
APP_PUBLIC_PATH=

VITE_APP_NAME="${APP_NAME}"
